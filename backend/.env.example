# ── Copy this file to .env and fill in real values ───────────────────────────
# NEVER commit .env to version control

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://niteshyadavwork_db_user:YOUR_PASSWORD@cluster0.juz2lwu.mongodb.net/stockyard?retryWrites=true&w=majority

# Port — Render injects this automatically
PORT=5000

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_64_char_hex_secret_here

# Frontend URL — used for CORS
# Local dev:   http://localhost:5173
# Production:  https://store-management-sys.netlify.app
CORS_ORIGIN=https://store-management-sys.netlify.app

# Environment
NODE_ENV=production
